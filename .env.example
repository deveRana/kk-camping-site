# ==============================================
# LAKEORA CAMPING SITE - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git (it's in .gitignore)

# ----------------------------------------------
# SANITY CMS Configuration
# ----------------------------------------------
# Get these from: https://sanity.io/manage
# Project ID: Found in your Sanity project settings
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Dataset: Usually 'production' or 'development'
NEXT_PUBLIC_SANITY_DATASET=production

# API Write Token: Create in Sanity > API > Tokens
# Required for: Creating/updating bookings, payments, gallery items
# Permissions: Editor or higher
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# ----------------------------------------------
# Email Configuration (Resend)
# ----------------------------------------------
# Get API key from: https://resend.com/api-keys
# Used for: Booking confirmations, contact form submissions
RESEND_API_KEY=re_your_resend_api_key_here

# Email address that sends notifications
# Must be verified in Resend dashboard
EMAIL_FROM=noreply@yourdomain.com

# Admin email to receive booking notifications
ADMIN_EMAIL=admin@yourdomain.com

# ----------------------------------------------
# Admin API Security
# ----------------------------------------------
# Optional: Secure your admin endpoints
# Generate a random string for production
ADMIN_API_TOKEN=your_secure_random_token_here

# ----------------------------------------------
# Payment Gateway - Razorpay
# ----------------------------------------------
# Get these from: https://dashboard.razorpay.com/app/keys
# Test Mode: Use test keys (rzp_test_...)
# Live Mode: Use live keys (rzp_live_...)

# Server-side key ID (SECRET - never expose to frontend)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-side key secret (SECRET - never expose to frontend)
RAZORPAY_KEY_SECRET=your_key_secret

# Public key for frontend (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
